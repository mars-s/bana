{
  // The Bana sync relay (docs/sync.md): a Worker and one Durable Object per synced workspace
  // ("room"). Built for the Workers free plan: SQLite-backed Durable Objects and the WebSocket
  // Hibernation API. It stores and forwards ciphertext only. Nothing here is a secret.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bana-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
